.venv/
__pycache__/
.pytest_cache/
output/
# /brag-slim launch-video output (and its timestamped brag-output-YYYY-MM-DD-HHmmss/ siblings): local only
brag-output*/

# Secrets and anything that can hold them. .env.example (blank template) is the only env file that belongs in git.
.env
.env.*
!.env.example
.streamlit/secrets.toml
.deepeval/
# Claude Code's local permissions file: can hold full command lines you approved
.claude/settings.local.json
# Saved run state (checkpoints) from local runs
checkpoints.db*
# Locally installed Claude Code skills (brag-slim, vibe-security) and their lock file: tools, not part of the project
.claude/skills/
skills-lock.json
