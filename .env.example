ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
TAVILY_API_KEY=
# Optional: Postgres checkpointer. Leave unset for local dev (uses checkpoints.db via SQLite).
DATABASE_URL=
# Optional: set to 1 on the public demo for a cheaper, shallower run (2 Researcher passes, 5 verification
# questions per round, instead of 3 and 8). Leave unset for full depth.
LOW_COST_MODE=

# --- Deployment only (set on Render, leave unset locally) ---
# Shared secret between the UI and the API: the same long random value on BOTH services, so only the UI can start
# paid work. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Optional daily caps on the API (defaults 20 briefings and 100 quick checks per day, UTC).
DAILY_BRIEFING_LIMIT=
DAILY_QUICK_CHECK_LIMIT=
# UI service only, set to "none": hides Python tracebacks from visitors (Streamlit's default shows them in full).
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=
